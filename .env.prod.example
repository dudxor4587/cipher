# 운영 시크릿 템플릿. 서버 ~/cipher-deploy/.env.prod 로 두고 채운다.
# (deploy.sh 가 없으면 랜덤으로 자동 생성. git 커밋 금지 — .gitignore 처리됨)
# 시크릿 생성:  openssl rand -hex 32
DB_PASSWORD=change-me
CIPHER_JWT_SECRET=change-me-64hex
CIPHER_AES_KEY=change-me-64hex
# 웹푸시 VAPID 키쌍 (deploy.sh 가 openssl 로 자동 생성. npx web-push generate-vapid-keys 로도 가능)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
# 호스트명은 deploy/edge/Caddyfile 에 하드코딩(cipher.134.185.100.62.sslip.io)
